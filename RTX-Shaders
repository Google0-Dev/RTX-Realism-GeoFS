// ==UserScript==
// @name         GeoFS A320neo Ultra-Shine & Realism
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Adds metallic reflections, high-gloss fuselage, and physics fixes to the A320neo
// @author       Google0
// @match        https://www.geo-fs.com/geofs.php*
// @match        https://*.geo-fs.com/geofs.php*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    function applyVisualOverhaul() {
        // Only target the A320neo (ID: 2180)
        if (geofs.aircraft.instance && geofs.aircraft.instance.id === "2180") {
            const a320 = geofs.aircraft.instance;

            // --- 1. VISUAL SHINE & REFLECTIONS ---
            // We iterate through the model parts to apply a "Metallic" finish
            if (a320.model && a320.model._model) {
                const meshes = a320.model._model._runtime.meshes;
                meshes.forEach(mesh => {
                    mesh.primitives.forEach(primitive => {
                        const material = primitive.material;
                        if (material) {
                            // Lower roughness = Shinier surface (0.1 is like glass/polished metal)
                            material.pbrMetallicRoughness.roughnessFactor = 0.15;
                            // Higher metallic = More sky reflections
                            material.pbrMetallicRoughness.metallicFactor = 0.5;
                            
                            // Adjusting the base color to react better to sunlight
                            material.emissiveFactor = [0.05, 0.05, 0.05]; 
                        }
                    });
                });
            }

            // --- 2. ENGINE & PHYSICS TWEAKS ---
            a320.setup.aerodynamics.pitchStability = 0.95;
            a320.setup.engines.forEach(eng => {
                eng.thrust = 120600; 
            });

            // --- 3. LIGHTING ENHANCEMENT ---
            // Makes the strobes "pop" more against the shiny fuselage
            geofs.fx.light.strobe.color = [1, 1, 1, 1.5];
            
            console.log("A320neo Visual & Physics Overhaul Active");
        }
    }

    // Run every 3 seconds to catch the model after it fully loads in
    setInterval(applyVisualOverhaul, 3000);
})();
