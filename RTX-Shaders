// ==UserScript==
// @name         GeoFS A320 Clean Realism
// @match        https://www.geo-fs.com/geofs.php*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    function applyCleanLook() {
        const ac = geofs.aircraft.instance;

        // Check if we are in an A320
        if (ac && ac.setup && ac.setup.name && ac.setup.name.includes("A320")) {
            
            // 1. FIX THE TEXTURE LIGHTING
            // This prevents the plane from looking 'flat' by adjusting the light gain
            if (geofs.api && geofs.api.viewer) {
                geofs.api.viewer.scene.globe.maximumScreenSpaceError = 2; // Sharpens ground textures
                geofs.api.viewer.scene.light.intensity = 3.5; // Brighter, cleaner sunlight
            }

            // 2. ENHANCE THE MODEL APPEARANCE
            // We use a safer way to access the model to avoid the 'undefined' error
            if (ac.model && ac.model._model && ac.model._model._runtime) {
                const meshes = ac.model._model._runtime.meshes;
                meshes.forEach(mesh => {
                    mesh.primitives.forEach(prim => {
                        if (prim.material && prim.material.pbrMetallicRoughness) {
                            // Subtle shine, not 'chrome' but 'clean'
                            prim.material.pbrMetallicRoughness.roughnessFactor = 0.25;
                            prim.material.pbrMetallicRoughness.metallicFactor = 0.3;
                        }
                    });
                });
            }
        }
    }

    // Run once every 5 seconds to stay stable
    setInterval(applyCleanLook, 5000);
})();
