// ==UserScript==
// @name         GeoFS A320neo Realism Pro
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Enhances physics, FBW feel, and engine thrust for the A320neo
// @author       Google0
// @match        https://www.geo-fs.com/geofs.php*
// @match        https://*.geo-fs.com/geofs.php*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    function applyA320Fixes() {
        // Check if aircraft is loaded and is the A320neo (ID: 2180)
        if (geofs.aircraft.instance && geofs.aircraft.instance.id === "2180") {
            const a320 = geofs.aircraft.instance;

            // --- FLIGHT CONTROL LAWS (Fly-By-Wire feel) ---
            // High stability values simulate the computer-assisted trimming
            a320.setup.aerodynamics.pitchStability = 0.9;
            a320.setup.aerodynamics.rollStability = 0.7;
            a320.setup.dragCoefficient = 0.022; // Slightly more drag for realistic descent profiles

            // --- CFM LEAP-1A ENGINE PHYSICS ---
            // Realistic thrust-to-weight ratio adjustments
            a320.setup.engines.forEach(eng => {
                eng.thrust = 120600; // Newtons
                eng.reverseThrust = 0.2; // A320s only use reverse thrust on the inner portion
            });

            // --- GROUND HANDLING ---
            // Improving suspension to prevent "bouncing" on landing
            a320.setup.parts.forEach(part => {
                if (part.name === "gear") {
                    part.suspensionWeight = 50;
                    part.suspensionDamping = 10;
                }
            });

            console.log("A320neo Realism Pro: Systems Active");
        }
    }

    // Run the check every 5 seconds to ensure it reapplies if you swap planes
    setInterval(applyA320Fixes, 5000);
})();
